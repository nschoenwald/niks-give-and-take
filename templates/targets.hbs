<fieldset class="ngt-targets">
  <legend>{{targetLabel}}</legend>
  <div class="ngt-target-list">
    {{#each targets}}
    <label class="ngt-target{{#if group}} ngt-group{{/if}}">
      <input type="radio" name="target" value="{{uuid}}" {{checked checked}}>
      <img src="{{img}}" alt="">
      <span class="ngt-target-name">{{name}}</span>
      {{#if group}}<i class="fa-solid fa-users" inert></i>{{/if}}
    </label>
    {{/each}}
  </div>
</fieldset>
